<resources>


    <style name="zone_title" parent="marquee">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="marquee">
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:freezesText">true</item>
    </style>



    <!--For list of popup menu -->
    <style name="winPopupAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/scale_down</item>
    </style>




    <!--for content of menu of configuration screen-->
    <style name="configContentItem" >
        <item name="android:textSize">13.3sp</item>
        <item name="android:textColor">@color/dark2</item>
        <item name="android:layout_marginStart">64.7dp</item>
    </style>

    <style name="DateTimeDialog" parent="Theme.AppCompat.Dialog">
        <!--        <item name="android:colorBackground">@color/white</item>-->
        <!--        <item name="android:textColorPrimary">#000000</item>-->
        <!--        <item name="android:headerBackground">#000000</item>-->
        <!--        <item name="android:textColorSecondary">#000000</item>-->
        <!--        <item name="android:button">@color/white</item>-->
        <!--        <item name="android:background">@color/white</item>-->
        <!--        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>-->

    </style>

    <style name="general_configuration">
        <item name="android:layout_height">70dp</item>
    </style>


    <style name="commands_emails_fields">
        <item name="android:layout_height">25dp</item>
        <item name="android:textSize">14.7sp</item>
        <item name="android:background">@drawable/edit_text_border</item>
        <item name="android:inputType">textEmailAddress</item>
    </style>

    <style name="configOperators">
        <item name="android:layout_marginTop">10dp</item>
    </style>


    <!-- window background of the init / activation screens (instead of painting it again in the layout) -->
    <!-- the theme of the app: a black status bar (as the action bar) with white icons.
         Before Android 15 the status bar is colored by colorPrimaryDark,
         since Android 15 the app is drawn edge to edge and a black view is drawn behind the status bar (SysSystemBars.kt) -->
    <style name="Theme.TrailManager" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimaryDark">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TrailManager.Gray">
        <item name="android:windowBackground">@color/gray1</item>
    </style>

    <style name="Theme.TrailManager.Init" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimaryDark">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/gray1</item>
    </style>

</resources>
